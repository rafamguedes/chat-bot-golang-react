# Copie para .env e configure sua chave apenas neste backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
HOST=127.0.0.1
PORT=8080
# Origens exatas autorizadas em desenvolvimento, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Depois de npm run build, o Go também serve a interface neste diretório.
FRONTEND_DIST=../frontend/dist
